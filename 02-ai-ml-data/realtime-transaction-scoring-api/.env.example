# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# SERVING NEEDS NONE OF THIS. The API loads the model and threshold from
# outputs/models/bundle_v1/ and reads no environment variables at all.
#
# These are for reproducing training only, and every one is optional —
# `python src/train.py` runs fully offline with none of them set.

# --- Experiment tracking (opt-in) -------------------------------------------
# Must be exactly "1" to enable. Any other value, or unset, means training
# makes no network calls at all — see _maybe_init_tracking() in src/train.py.
TRACK_WITH_DAGSHUB=

# Only read when TRACK_WITH_DAGSHUB=1. Both have defaults in src/train.py,
# so set them only if you are logging to your own DagsHub repo.
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=

# Read by the dagshub library itself, not by this project's code.
# An access token, NOT your password — https://dagshub.com/user/settings/tokens
DAGSHUB_USER_TOKEN=
