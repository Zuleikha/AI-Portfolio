# Secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment tracking — regenerated locally, never part of the repo
mlruns/
mlflow.db
*.db

# Kaggle creditcard.csv is not redistributed — download it yourself
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artefacts. ONLY the reviewed serving bundle is committed — everything
# else under outputs/models/ is a local intermediate: notebook baselines,
# imbalance experiments, and retrain candidates awaiting manual promotion.
outputs/models/*
!outputs/models/bundle_v1/

# Figures ARE committed: they are the visual record of the analysis.

# Notebook checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Personal study files, never committed
*-architecture-study.html
*-prep.html

# Local Claude edit-audit log, written by the PostToolUse hook
docs/decisions/auto-changes.log
