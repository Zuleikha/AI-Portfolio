# Copy to .env and edit. Never commit .env — it is git-ignored.
# Every value below is optional; the defaults shown are what the service uses
# when the variable is unset.

# --- Ranking backend ---------------------------------------------------------
# "lexical" (TF-IDF, default) or "embedding".
# "embedding" requires the optional extra: pip install -e ".[embeddings]"
RANKING_METHOD=lexical

# Sentence-transformers checkpoint, used only when RANKING_METHOD=embedding.
# Downloaded from the Hugging Face Hub on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Score weights -----------------------------------------------------------
# These three MUST sum to 1.0 or the service refuses to start.
SKILL_WEIGHT=0.5
EXPERIENCE_WEIGHT=0.3
SIMILARITY_WEIGHT=0.2

# Within the skill component, the share attributed to required (versus
# preferred) skills. Range [0, 1].
REQUIRED_SKILL_SHARE=0.8

# --- Candidate store ---------------------------------------------------------
# Hard cap on in-memory candidates. Uploads beyond this are rejected with 507,
# never silently evicted.
MAX_CANDIDATES=1000

# Maximum resume length in characters. Longer submissions are rejected with 413.
MAX_RESUME_CHARS=20000

# --- API ---------------------------------------------------------------------
# When set, the WRITE endpoints (POST /candidates, POST /candidates/upload,
# DELETE /candidates/{id}) require a matching X-API-Key header.
# When unset the API is open. Read and ranking endpoints are never gated —
# see docs/SECURITY.md.
# API_KEY=

# Comma-separated allowed origins. Defaults to "*"; narrow this before exposing
# the service.
CORS_ORIGINS=*

LOG_LEVEL=INFO
