# Copy to .env and fill in. Never commit the real .env.

# --- Secrets: environment only, never in config/*.yaml -----------------------

# Anthropic API key used for menu extraction.
ANTHROPIC_API_KEY=

# Postgres connection string.
DATABASE_URL=postgresql+psycopg://menuforge:menuforge@localhost:5432/menuforge

# --- Configuration -----------------------------------------------------------
# Everything below is optional. Precedence is:
#   environment variable  >  config/<MENUFORGE_ENV>.yaml  >  code default
# Set a variable here only to override what the YAML file already says.

# Which config/<name>.yaml to load: development | production
MENUFORGE_ENV=development

# Where the YAML files live. Relative to the working directory.
# MENUFORGE_CONFIG_DIR=config

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# MENUFORGE_LOG_LEVEL=INFO

# MENUFORGE_MODEL=claude-sonnet-5
# MENUFORGE_MAX_RETRIES=2
# MENUFORGE_MAX_TOKENS=8000
# MENUFORGE_EFFORT=low

# MENUFORGE_MAX_UPLOAD_BYTES=10485760
