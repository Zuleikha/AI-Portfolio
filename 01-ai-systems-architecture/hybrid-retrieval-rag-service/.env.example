# Copy to .env and fill in. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
# Answer generation
ANTHROPIC_API_KEY=
# Embeddings (embed-english-v3.0) and reranking (rerank-v3.5) — both use this key
COHERE_API_KEY=
# Vector store
PINECONE_API_KEY=

# ── Optional — defaults shown ─────────────────────────────────────────────────
# 1024-dim serverless index; created on first run if it does not exist
PINECONE_INDEX_NAME=hybrid-retrieval-rag

LLM_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=embed-english-v3.0

# Retrieval: candidates fetched per leg, and how many survive reranking
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3

# Chunking, in tokens
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Generation
MAX_TOKENS=1024
TEMPERATURE=0.1

LOG_LEVEL=INFO
DEBUG=false
