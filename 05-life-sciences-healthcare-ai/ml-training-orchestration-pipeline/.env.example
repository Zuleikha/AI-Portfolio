# Copy to .env and adjust. Never commit .env.
# Every value below has a working default — the pipeline runs with no .env at all.

# MLflow tracking. Local file store by default; point at a server to centralise runs.
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=ml-training-orchestration-pipeline

# Only needed for gated or private HuggingFace models. Public datasets need nothing.
HUGGINGFACE_TOKEN=

# Where the training run writes its bundle, and where the API loads it from
MODEL_DIR=models
DATA_DIR=data
PIPELINE_CONFIG_PATH=config/pipeline.yaml

# Serving
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Drift detection
DRIFT_DETECTION_ENABLED=true
DRIFT_CHECK_INTERVAL=3600

LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG=true
