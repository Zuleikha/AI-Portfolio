# Copy to .env and fill in. Never commit .env.

# NCBI E-utilities (https://www.ncbi.nlm.nih.gov/account/settings/)
# API key is optional: 3 requests/sec without, 10 with.
NCBI_API_KEY=your-ncbi-api-key
NCBI_EMAIL=you@example.com

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
# Model for the citation check (Stage 5). May be the same as ANTHROPIC_MODEL.
ANTHROPIC_CHECK_MODEL=claude-haiku-5-5

# LangSmith tracing (Stage 7). Used ONLY with --trace. Free plan only.
# Key: https://smith.langchain.com (Settings -> API Keys). Project defaults to research-agent.
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=research-agent
